/* Phosphor-green retro look */
Screen {
    background: #050a06;
    color: #33ff66;
}

#steps {
    height: 1;
    padding: 0 2;
    background: #0a140c;
    color: #1f8f3f;
}

.heading {
    margin: 1 2 0 2;
    color: #66ff99;
    text-style: bold;
}

.note {
    margin: 0 2;
    color: #ffb000;
}

.dim {
    margin: 0 2;
    color: #1f8f3f;
}

OptionList {
    background: #050a06;
    color: #33ff66;
    border: round #1f8f3f;
    height: auto;
    max-height: 22;
    margin: 1 2;
}

OptionList > .option-list--option-highlighted {
    background: #124d20;
    color: #eaffea;
    text-style: bold;
}

OptionList > .option-list--option-disabled {
    color: #3b6b47;
}

Footer {
    background: #0a140c;
    color: #33ff66;
}

/* welcome */
WelcomeScreen {
    align: center middle;
}

#welcome-box {
    width: 74;
    height: auto;
    align-horizontal: center;
}

#art {
    color: #33ff66;
    text-style: bold;
    width: auto;
}

#tagline {
    margin-top: 1;
    color: #66ff99;
    width: 100%;
    text-align: center;
}

#subline {
    color: #1f8f3f;
    width: 100%;
    text-align: center;
}

#hint {
    margin-top: 2;
    color: #1f8f3f;
    width: 100%;
    text-align: center;
}

#credits {
    margin-top: 1;
    color: #145c2b;
    width: 100%;
    text-align: center;
}

AboutScreen {
    align: center middle;
    background: #050a06 80%;
}

#about-box {
    width: 74;
    height: auto;
    padding: 1 3;
    border: double #33ff66;
    background: #0a140c;
    color: #33ff66;
}

#about-title {
    text-style: bold;
    color: #eaffea;
}




Input {
    background: #050a06;
    color: #eaffea;
    border: round #1f8f3f;
}

Input:focus {
    border: round #66ff99;
}

/* checkboxes: empty box when unmarked, bright mark when marked */
SelectionList > .selection-list--button {
    background: #0f1a12;
    color: #0f1a12;
}

SelectionList > .selection-list--button-highlighted {
    background: #124d20;
    color: #124d20;
}

SelectionList > .selection-list--button-selected {
    background: #1f8f3f;
    color: #eaffea;
    text-style: bold;
}

SelectionList > .selection-list--button-selected-highlighted {
    background: #33ff66;
    color: #050a06;
    text-style: bold;
}

ImageChoice, NewFolder {
    align: center middle;
    background: #050a06 80%;
}

.dialog-box {
    width: 64;
    height: auto;
    padding: 1 3;
    border: double #33ff66;
    background: #0a140c;
}

.dialog-title {
    text-style: bold;
    color: #eaffea;
}

DirectoryTree {
    background: #050a06;
    color: #33ff66;
    border: round #1f8f3f;
    margin: 1 2;
    height: 1fr;
}

DirectoryTree > .tree--cursor {
    background: #124d20;
    color: #eaffea;
    text-style: bold;
}
